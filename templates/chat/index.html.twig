{% extends 'base.html.twig' %}

{% block title %}Chat with jesus!{% endblock %}

{% block body %}
<div id="chat-container" data-controller="chat">
    <div class="container form chat">
    <div id="messages" data-chat-target="messages" class="h-64 overflow-y-auto border p-4 mb-4">
        <!-- Messages will appear here -->
    </div>

    <form data-action="submit->chat#sendMessage">
        <div class="form-group mb-3">
            <label>
                {{ 'type_message'|trans }}
            </label>
            <textarea  data-chat-target="input" class="border p-2 w-full" rows="15" cols="40"></textarea>
        </div>
        <div class="form-group mb-3">
        <button type="submit">{{ 'send'|trans() }}</button>
        </div>
    </form>
    {% if app.user %}
    <a href="{{ path('app_chat_histories') }}" target="_blank"> {{ 'histories'|trans()|capitalize }} </a>
    {% endif %}
    </div>
</div>
{% endblock %}
