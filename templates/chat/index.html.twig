{% extends 'base.html.twig' %}

{% block title %}Chat with jesus!{% endblock %}

{% block body %}

<div id="chat-container" data-controller="chat" data-chat-default-value="{{ 'type_message'|trans }}">
    <div id="messages" data-chat-target="messages">
    </div>

    <div class="container form chat">
    <form data-action="submit->chat#sendMessage">
        <div class="form-group mb-3">
            <textarea  data-action="focus->chat#onFocus blur->chat#onBlur" data-chat-target="input" class="border p-2 w-full" rows="5" cols="40" >{{ 'type_message'|trans }}</textarea>
        </div>
        <div class="form-group mb-3">
        <button type="submit">{{ 'send'|trans() }}</button>
        </div>
    </form>
    {% if app.user %}
    <a href="{{ path('app_chat_histories') }}" target="_blank"> {{ 'histories'|trans()|capitalize }} </a>
    {% endif %}
    </div>
</div>
{% endblock %}
