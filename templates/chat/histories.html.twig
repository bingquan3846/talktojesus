{% extends 'base.html.twig' %}

{% block title %}Chat with jesus!{% endblock %}

{% block body %}
    <div id="chat-container" data-controller="chat">
            {%  if histories %}
                <h2>Here are all of histories</h2>
                <ul>
                    {% for history in histories %}
                        <li>
                            <p>{{ history.question|e }} <br/>
                            {{ history.answer|u.truncate(200, '...') }} <br/>
                                <a href="{{ path('app_chat_history', {'id': history.id}) }}" target="_blank">Read more</a>
                            </p>
                        </li>
                    {% endfor %}
                </ul>
            {%  endif %}
    </div>
{% endblock %}
