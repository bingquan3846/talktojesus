{% extends 'base.html.twig' %}

{% block title %}Chat with jesus!{% endblock %}

{% block body %}
    <div id="chat-histories">
          {# 
            {%  if initialHistories %}
                <div {{ vue_component('HistoryList', {
                histories: initialHistories
            }) }}>
                </div>
            {%  endif %}
            #}
             {%  if initialHistories %}
                <h2>Here are all of histories</h2>
                <ul>
                    {% for history in initialHistories %}
                        <li>
                            <p>{{ history.question|capitalize }} <br/>
                            {{ history.answer|u.truncate(200, '...') }} <br/>
                                <a href="{{ path('app_chat_history', {'id': history.id}) }}" target="_blank">Read more</a>
                                

                                {% if is_granted('POST_DELETE', history) %}
                                    <a href="{{ path('app_chat_history_delete', {id: history.id}) }}" class="btn btn-danger">Delete</a>
                                {% endif %}
                            </p>
                        </li>
                    {% endfor %}
                </ul>
            {%  endif %}
    </div>
{% endblock %}
