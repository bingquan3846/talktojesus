{% extends 'base.html.twig' %}

{% block title %}Chat with jesus!{% endblock %}

{% block body %}
    <div id="chat-container" data-controller="chat">
        {%  if history %}
            <h2>Here are this history</h2>
            <div>
                {% set items = history.answer |split('###') %}
              <h3>{{ history.question }}</h3>
                {% for item in items %}
                    <p>{{ item }}</p>
                {% endfor %}
            </div>
        {%  endif %}
    </div>
{% endblock %}
